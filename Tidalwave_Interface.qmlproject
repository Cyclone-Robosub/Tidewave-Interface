import QmlProject

Project {
    mainFile: "Tidalwave_InterfaceContent/App.qml"
    mainUiFile: "Tidalwave_InterfaceContent/TIDALWAVE_INTERFACE_P1.ui.qml"
    qt6Project: true
    importPaths: [ "." ]

    /* Include .qml, .js, and image files from current directory and subdirectories */
    QmlFiles {
        directory: "Tidalwave_Interface"
    }
    QmlFiles {
        directory: "Generated"
    }

    JavaScriptFiles {
        directory: "Tidalwave_Interface"
    }

    JavaScriptFiles {
        directory: "Tidalwave_InterfaceContent"
    }

    ImageFiles {
        directory: "Tidalwave_InterfaceContent"
    }

    ImageFiles {
        directory: "Generated"
    }
     ImageFiles {
        files: [
            "assets/repeat_group_1.png",
            "assets/repeat_group_3.png",
            "assets/rOLL_1.png",
            "assets/repeat_group_2.png",
            "assets/rOLL.png",
            "assets/tHRUSTER.png",
            "assets/gRAPH_COMPONENTS_2.png",
            "assets/gRAPH_COMPONENTS_1.png",
            "assets/gRAPH_COMPONENTS.png",
            "assets/cAMERA.png",
            "assets/repeat_group_5.png",
            "assets/repeat_group_4.png",
            "assets/image_1.png"
        ]
    }
    Files {
        filter: "*.conf"
        files: ["qtquickcontrols2.conf"]
    }

    Files {
        filter: "qmldir"
        directory: "Tidalwave_InterfaceContent"
    }

    FontFiles {
        filter: "*.ttf;*.otf"
        directory: "."
    }

    Files {
        filter: "*.wav;*.mp3"
        directory: "."
    }

    Files {
        filter: "*.mp4"
        directory: "."
    }

    Files {
        filter: "*.glsl;*.glslv;*.glslf;*.vsh;*.fsh;*.vert;*.frag"
        directory: "."
    }
    ModuleFiles {
        files: [ "Tidalwave_Interface/DesignTokens/DesignTokens.qmlproject" ]
    }
    Files {
        filter: "*.qsb"
        directory: "."
    }

    Files {
        filter: "*.json"
        directory: "."
    }

    Files {
        filter: "*.mesh"
        directory: "Generated"
    }

    Files {
        filter: "*.qad"
        directory: "Generated"
    }

    Environment {
        QT_QUICK_CONTROLS_CONF: "qtquickcontrols2.conf"
        QML_COMPAT_RESOLVE_URLS_ON_ASSIGNMENT: "1"
        QT_LOGGING_RULES: "qt.qml.connections=false"
        QT_ENABLE_HIGHDPI_SCALING: "0"
    }
    qt6Project: true
    importPaths: [ ".", "Tidalwave_Interface" ]
    targetDirectory: "/opt/Tidalwave_Interface"
    enableCMakeGeneration: true
    standaloneApp: true

    qdsVersion: "4.8"

    quickVersion: "6.8"

    /* If any modules the project imports require widgets (e.g. QtCharts), widgetApp must be true */
    widgetApp: true

    /* Shader compilation tool configuration */
    ShaderTool {
        args: "-s --glsl \"100 es,120,150\" --hlsl 50 --msl 12"
        files: [ "Tidalwave_InterfaceContent/shaders/*" ]
    }

    multilanguageSupport: true
    supportedLanguages: ["en"]
    primaryLanguage: "en"

    // Added resource file configuration
    Resources {
        files: [
      "Tidalwave_InterfaceContent/App.qml",
      "Tidalwave_InterfaceContent/TIDALWAVE_INTERFACE_P1.ui.qml"
       "Tidalwave_InterfaceContent/DEPTH.ui.qml"
        "Tidalwave_InterfaceContent/NAV_YAW_DEPTH.ui.qml"
         "Tidalwave_InterfaceContent/Battery_Default.ui.qml"
"Tidalwave_InterfaceContent/GRAPH_COMPONENTS.ui.qml"
"Tidalwave_InterfaceContent/Voltage_detail_overlay.ui.qml"
 "Tidalwave_InterfaceContent/TEST.ui.qml"
        ]
    }
}